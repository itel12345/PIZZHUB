# .env.example — NAMES AND PLACEHOLDERS ONLY. Never put real values in this
# file. Copy to .env (git-ignored) for local use; on Netlify set the same
# names in Site configuration -> Environment variables.

# ── Database (Supabase Postgres) ───────────────────────────────────────
# Runtime connection used by the app. On Netlify use the pooled address.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
# Direct connection, used only by `prisma migrate` from your own machine.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Site ───────────────────────────────────────────────────────────────
# Canonical public URL, no trailing slash. Links in emails are built from
# this (never from the request's Host header).
APP_URL="https://your-site.example"
# Optional: extra origins allowed to POST to the API (comma-separated),
# e.g. a dev tunnel. Leave unset in production.
# ALLOWED_ORIGINS=""

# ── Auth ───────────────────────────────────────────────────────────────
# Email for the owner admin account.
OWNER_ADMIN_EMAIL="owner@your-site.example"
# Leave UNSET until email delivery is configured AND tested AND the rollout
# plan says to enable it. "true" blocks sign-in for unverified accounts.
# AUTH_REQUIRE_EMAIL_VERIFICATION="true"
# LEGACY: no longer used since the session rewrite. Keep it set until the new
# release has been verified on the live site (a rollback needs it), then remove.
JWT_SECRET="legacy-do-not-use"

# ── Email (Resend) ─────────────────────────────────────────────────────
RESEND_API_KEY="your-resend-api-key-here"
# The sending domain must be verified in Resend.
EMAIL_FROM="PizzHub <no-reply@mail.your-site.example>"

# ── Payments (Paystack) ────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_live_or_test_xxxxxxxxxxxx"

# ── Profile pictures (Supabase Storage) ────────────────────────────────
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-goes-here"
# SUPABASE_AVATAR_BUCKET="avatars"

# ── Product image uploads (Cloudinary) ─────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="000000000000000"
CLOUDINARY_API_SECRET="cloudinary-secret-goes-here"
